<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:padding="24dp"
    android:clipToPadding="false"
    android:clipChildren="false">

    <!-- CONTAINER -->

    <LinearLayout
        android:id="@+id/formContainer"
        android:layout_width="match_parent"
        android:layout_height="514dp"
        android:layout_marginTop="25dp"
        android:orientation="vertical"
        tools:layout_marginTop="80dp">

        <!-- ================= TOP BOX ================= -->

        <LinearLayout
            android:id="@+id/topBox"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginBottom="0dp"
            android:background="@drawable/bg_topbox_diagonal"
            android:elevation="10dp"
            android:padding="16dp"
            android:paddingBottom="40dp">

            <RelativeLayout
                android:layout_width="336dp"
                android:layout_height="224dp">

                <!-- INPUT BAR -->

                <LinearLayout
                    android:id="@+id/inputBar"
                    android:layout_width="333dp"
                    android:layout_height="160dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- EMAIL -->

                    <EditText
                        android:id="@+id/email"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@android:color/transparent"
                        android:hint="Email"
                        android:inputType="textEmailAddress"
                        android:minHeight="48dp"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary" />

                    <!-- BLACK LINE -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="10dp"
                        android:background="@color/divider" />

                    <!-- PASSWORD -->

                    <EditText
                        android:id="@+id/password"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@android:color/transparent"
                        android:hint="Password"
                        android:inputType="textPassword"
                        android:minHeight="48dp"
                        android:padding="12dp"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary" />

                    <!-- BLACK LINE -->

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider" />

                    <!-- FORGOT PASSWORD -->

                    <TextView
                        android:id="@+id/forgotPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="10dp"
                        android:text="Forgot Password?"
                        android:textColor="@color/primary_button"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- SHIMMER LOGIN BUTTON -->

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="175dp"
                    app:shimmer_auto_start="true"
                    app:shimmer_duration="1200">

                    <Button
                        android:id="@+id/loginBtn"
                        android:layout_width="85dp"
                        android:layout_height="50dp"
                        android:backgroundTint="@color/primary_button"
                        android:gravity="center"
                        android:padding="0dp"
                        android:text="Login"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </com.facebook.shimmer.ShimmerFrameLayout>

            </RelativeLayout>

        </LinearLayout>

        <!-- ================= BOTTOM BOX ================= -->

        <LinearLayout
            android:id="@+id/bottomBox"
            android:layout_width="match_parent"
            android:layout_height="249dp"
            android:layout_marginTop="0dp"
            android:background="@drawable/bg_bottombox_diagonal"
            android:elevation="10dp"
            android:orientation="vertical"
            android:padding="16dp">

        </LinearLayout>

    </LinearLayout>

    <!-- CREATE ACCOUNT -->

    <Button
        android:id="@+id/createAccountBtn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="30dp"
        android:background="@drawable/bg_white_button"
        android:text="Create Account"
        android:textAllCaps="false"
        android:textColor="@color/primary_button"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout> 