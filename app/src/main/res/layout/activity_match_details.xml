<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 🎉 HEADER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎉 Match Found!"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="20dp"/>

        <!-- 🔥 CARD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/card"
            xmlns:app="http://schemas.android.com/apk/res-auto">

            <LinearLayout
                android:orientation="vertical"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- ITEM TITLE -->
                <TextView
                    android:id="@+id/itemTitle"
                    android:text="📦 Item Name"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <!-- FINDER NAME -->
                <TextView
                    android:id="@+id/finderName"
                    android:text="👤 Name: John Doe"
                    android:textSize="16sp"
                    android:textColor="@color/text_secondary" 
                    android:layout_marginTop="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <!-- PHONE -->
                <TextView
                    android:id="@+id/finderPhone"
                    android:text="📞 Phone: 9876543210"
                    android:textSize="16sp"
                    android:textColor="@color/text_secondary" 
                    android:layout_marginTop="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <!-- LOCATION -->
                <TextView
                    android:id="@+id/finderLocation"
                    android:text="📍 Location: Campus"
                    android:textSize="16sp"
                    android:textColor="@color/text_secondary" 
                    android:layout_marginTop="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- 📞 CALL BUTTON -->
        <Button
            android:id="@+id/callFinderBtn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#4CAF50"
            android:text="📞 Call Finder"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"

            android:textSize="20sp" />

        <!-- ✅ CONFIRM BUTTON -->
        <Button
            android:id="@+id/confirmBtn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#2196F3"
            android:text="✅ Confirm Item Received"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

    </LinearLayout>

</ScrollView>