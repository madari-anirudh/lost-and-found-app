<?xml version="1.0" encoding="utf-8"?>


   <shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background color -->
    <solid android:color="#e3d3d3"/>

    <!-- Border -->
    <stroke
        android:width="1dp"
        android:color="#DADADA"/>

    <!-- Rounded corners -->
    <corners android:radius="15dp"/>

    <!-- Padding inside -->
    <padding
        android:left="12dp"
        android:right="12dp"
        android:top="10dp"
        android:bottom="10dp"/>

</shape>
