<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Background color -->
    <solid android:color="#FFFFFF"/>

    <!-- Border (focused state) -->
    <stroke
        android:width="2dp"
        android:color="#2196F3"/>

    <!-- Rounded corners -->
    <corners android:radius="30dp"/>

    <!-- Inner padding -->
    <padding
        android:left="12dp"
        android:right="12dp"
        android:top="10dp"
        android:bottom="10dp"/>

</shape>